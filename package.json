{
	"name": "obsidian-wrapper-icon",
	"version": "0.0.1",
	"description": "This is a wrapper icon plugin for Obsidian (https://obsidian.md)",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint .",
		"lint:oxc": "oxlint src esbuild.config.mjs version-bump.mjs",
		"format": "oxfmt --write 'src/**/*.ts' '*.mjs' 'styles.css'",
		"format:check": "oxfmt --check 'src/**/*.ts' '*.mjs' 'styles.css'"
	},
	"keywords": [],
	"license": "MIT",
	"devDependencies": {
		"@codemirror/language": "^6.12.4",
		"@codemirror/state": "6.5.0",
		"@codemirror/view": "6.38.6",
		"@eslint/js": "^9.39.4",
		"@types/node": "^22.15.17",
		"esbuild": "0.25.5",
		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "^0.4.0",
		"globals": "^17.6.0",
		"jiti": "^2.6.1",
		"obsidian": "latest",
		"oxfmt": "^0.63.0",
		"oxlint": "^1.78.0",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.59.1"
	},
	"allowScripts": {
		"esbuild@0.25.5": true
	}
}
